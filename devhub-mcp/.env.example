# devhub-mcp configuration — NAMES ONLY, never commit real values.
#
# In normal use these are passed by the MCP client (see README "Client configuration"),
# not loaded from a file. This file documents the contract.

# Fine-grained PAT, read-only, scoped to the work org's repositories.
GITHUB_WORK_TOKEN=

# Fine-grained PAT, read-only, scoped to your personal repositories.
# Must be a DIFFERENT token from GITHUB_WORK_TOKEN — the server keeps the two
# clients strictly separate and never falls back from one to the other.
GITHUB_PERSONAL_TOKEN=

# The GitHub organisation used for `scope: "work"` queries (e.g. headout).
GITHUB_WORK_ORG=

# Your personal GitHub username, used for `scope: "personal"` queries.
GITHUB_PERSONAL_USERNAME=

# Linear personal API key from https://linear.app/settings/account/security
LINEAR_API_KEY=

# The email address your Linear account uses; resolves "my" issues.
LINEAR_USER_EMAIL=
